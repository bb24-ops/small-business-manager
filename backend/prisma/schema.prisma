generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ResourceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNAVAILABLE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  OVERDUE
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id        String         @id @default(uuid()) @db.Char(36)
  firstName String         @db.VarChar(100)
  lastName  String         @db.VarChar(100)
  email     String         @unique @db.VarChar(191)
  phone     String?        @db.VarChar(50)
  position  String         @db.VarChar(120)
  status    EmployeeStatus @default(ACTIVE)
  tasks     Task[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@index([lastName, firstName])
}

model Task {
  id          String       @id @default(uuid()) @db.Char(36)
  title       String       @db.VarChar(150)
  description String?      @db.Text
  startsAt    DateTime
  dueAt       DateTime
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  employeeId  String?      @db.Char(36)
  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([title])
  @@index([employeeId])
}

model ResourceCategory {
  id          String     @id @default(uuid()) @db.Char(36)
  name        String     @unique @db.VarChar(100)
  description String?    @db.Text
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Resource {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @db.VarChar(150)
  code        String           @unique @db.VarChar(50)
  description String?          @db.Text
  location    String?          @db.VarChar(150)
  status      ResourceStatus   @default(AVAILABLE)
  quantity    Int              @default(1)
  categoryId  String           @db.Char(36)
  category    ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model Reservation {
  id         String   @id @default(uuid()) @db.Char(36)
  taskId     String   @db.Char(36)
  resourceId String   @db.Char(36)
  startsAt   DateTime
  endsAt     DateTime
  quantity   Int      @default(1)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, resourceId])
  @@index([resourceId, startsAt, endsAt])
  @@index([taskId])
  @@index([startsAt])
}
